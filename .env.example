# -- Realtime Traffic Tracker PoC ---------------------------------------------
# Copy to .env and edit. Everything works with NO changes (demo mode).

# Which provider feeds the dashboard: mock | ga4 | cloudflare
ANALYTICS_PROVIDER=mock

# HTTP port (used by `make run`)
PORT=8000

# Upstream poll cadence in seconds. Default: 3 (mock) / 15 (ga4, cloudflare).
# Polling is per-property, never per-dashboard-viewer.
#POLL_INTERVAL_SECONDS=15

# Demo mode only: background fake-traffic generator
SIMULATE_TRAFFIC=true

# -- GA4 (ANALYTICS_PROVIDER=ga4) ---------------------------------------------
# Numeric property id (GA4 Admin -> Property Settings)
#GA4_PROPERTY_ID=501234567

# Path to a service-account JSON key. Create the SA in Google Cloud, enable the
# "Google Analytics Data API", then add the SA email as Viewer on the property.
#GOOGLE_APPLICATION_CREDENTIALS=./ga4-service-account.json

# Optional: when set, the demo site + tracker.js also load real gtag, so demo
# pageviews flow into your GA4 property too (the "dual-send" setup).
#GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# -- Cloudflare (ANALYTICS_PROVIDER=cloudflare) -------------------------------
# API token scoped Zone -> Analytics -> Read
#CF_API_TOKEN=your_cloudflare_api_token

# Zone tag (32-hex id, CF dashboard -> zone Overview, right column)
#CF_ZONE_ID=0123456789abcdef0123456789abcdef
